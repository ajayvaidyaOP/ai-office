{
  "name": "04 · Record approval decision",
  "nodes": [
    {
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "id": "d4000000-0000-4000-8000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [-520, 0],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CREDENTIAL", "name": "Telegram account" } }
    },
    {
      "parameters": {
        "jsCode": "// Chapter 7 — record Approve / Revise / Reject.\nconst ALLOWED = [111111111]; // <-- your Telegram user ID\nconst msg = $input.first().json.message || {};\nconst fromId = msg.from?.id;\nconst chatId = msg.chat?.id;\nconst text = (msg.text || '').trim();\n\nif (!fromId || !chatId) return [];\nif (!ALLOWED.includes(fromId)) return [{ json: { denied: true, chatId } }];\n\nconst match = text.match(/^\\/(approve|revise|reject)\\s+(D-\\d{3,})/i);\nif (!match) return [{ json: { ignored: true, chatId } }];\n\nconst action = match[1].toLowerCase();\nconst draftId = match[2].toUpperCase();\nconst feedback = text.replace(match[0], '').trim();\nconst status = action === 'approve' ? 'Approved' : action === 'revise' ? 'Revision requested' : 'Rejected';\n\nreturn [{\n  json: {\n    action,\n    draftId,\n    status,\n    feedback,\n    chatId,\n    reviewer: 'tg:' + fromId,\n    decisionAt: new Date().toISOString().slice(0, 16).replace('T', ' '),\n  },\n}];"
      },
      "id": "d4000000-0000-4000-8000-000000000002",
      "name": "Parse decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-300, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.draftId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d4000000-0000-4000-8000-000000000003",
      "name": "Has draft ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-80, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "YOUR_SPREADSHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Drafts", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Draft ID": "={{ $json.draftId }}",
            "Status": "={{ $json.status }}",
            "Reviewer": "={{ $json.reviewer }}",
            "Decision At": "={{ $json.decisionAt }}",
            "Feedback": "={{ $json.feedback }}"
          },
          "matchingColumns": ["Draft ID"],
          "schema": []
        },
        "options": {}
      },
      "id": "d4000000-0000-4000-8000-000000000004",
      "name": "Update Drafts row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [160, -60],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_GOOGLE_CREDENTIAL", "name": "Google Sheets account" } },
      "notes": "Set matching column Draft ID → Draft ID in the node UI after import, and confirm the tab name."
    },
    {
      "parameters": {
        "chatId": "={{ $('Parse decision').first().json.chatId }}",
        "text": "=✅ {{ $('Parse decision').first().json.draftId }} recorded as “{{ $('Parse decision').first().json.status }}”.\n\n{{ $('Parse decision').first().json.action === 'approve' ? 'Copy the draft and publish it yourself — this office never posts on its own.' : 'Nothing was changed outside the sheet.' }}",
        "additionalFields": {}
      },
      "id": "d4000000-0000-4000-8000-000000000005",
      "name": "Confirm to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [420, -60],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CREDENTIAL", "name": "Telegram account" } }
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "Use /approve D-0001, /revise D-0001 your feedback, or /reject D-0001 reason.",
        "additionalFields": {}
      },
      "id": "d4000000-0000-4000-8000-000000000006",
      "name": "Help reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [160, 140],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CREDENTIAL", "name": "Telegram account" } }
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Parse decision", "type": "main", "index": 0 }]] },
    "Parse decision": { "main": [[{ "node": "Has draft ID?", "type": "main", "index": 0 }]] },
    "Has draft ID?": {
