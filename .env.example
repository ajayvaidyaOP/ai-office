# ============================================================
# AI Invincible Office — environment configuration
# Copy this file to .env and fill in what you have.
# Never commit .env. Never paste these values into Google Sheets.
# ============================================================

# --- App -----------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Folder for the office database (git-ignored by default)
DATA_DIR=./data
# Seed the Chapter 4 / Chapter 7 worked example on first boot
SEED_DEMO=true
# Used for dates in reports: Asia/Kolkata, UTC, etc.
OFFICE_TIMEZONE=Asia/Kolkata

# --- Access control (Chapter 9) ------------------------------
# Only these IDs may run commands. Comma separated. "owner" is the web console.
ALLOWED_USER_IDS=owner

# --- AI provider ---------------------------------------------
# auto | ollama | gemini | offline
AI_PROVIDER=auto

# Ollama (local, free). When n8n runs in Docker use host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Gemini (optional hosted fallback). Keep the key out of Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Hard stop for model calls per day (protects your wallet)
MAX_MODEL_CALLS_PER_DAY=200

# Path to a service-account JSON if you want the server to sync rows directly

# --- Telegram (Chapter 3) ------------------------------------
# Token from @BotFather. Keep it in .env or the n8n credential store only.
TELEGRAM_BOT_TOKEN=
# Comma separated numeric Telegram user IDs allowed to trigger workflows
ALLOWED_TELEGRAM_USER_IDS=
# off = no connector | polling = long-poll (local, no public URL)
TELEGRAM_MODE=off

# Shared secret for POST /api/webhook/telegram (optional bridge mode)
WEBHOOK_SECRET=

# --- Access gate (recommended if this is not localhost) ------
# If set, every /api/* call needs the header: x-office-code: <value>
# The dashboard now asks for this code once and remembers it in your browser,
# so the lock no longer breaks the UI. Without it, anyone who can reach the
# port can read and change your office.
OFFICE_ACCESS_CODE=

# --- Website Auditor ----------------------------------------
# The auditor opens each lead's public page and reports what it can actually see.
# It is polite by design: one request per page, a timeout, and a byte cap.
AUDIT_TIMEOUT_MS=8000
AUDIT_MAX_BYTES=400000
AUDIT_PER_RUN=5

# --- Follow-up cadence (days after the first message) -------
FOLLOWUP_DAYS_1=3
FOLLOWUP_DAYS_2=7

# --- Daily scheduler ----------------------------------------
# One in-process tick a minute. At the hour below (office timezone) it builds
# the morning brief + follow-up queue and sends it to YOU on Telegram.
# It never contacts a client. SCHEDULER=off disables it (tests do this).
SCHEDULER=on
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0
# Where scheduled briefs are delivered. Deliberately separate from client data.
TELEGRAM_OWNER_CHAT_ID=

# --- Live lead sourcing --------------------------------------
# Where Client Finder pulls REAL businesses from. Every row keeps its source URL.
# auto = Google Places if a key is present, otherwise OpenStreetMap (free).
SOURCING_PROVIDER=auto

# Optional. Google Places API (New) — best coverage for Indian SMBs, includes
# rating + review counts. Enable "Places API (New)" in Google Cloud, then paste
# the key. Billing is per request (Text Search is a paid SKU) — set a quota cap.
# Leave empty to use OpenStreetMap, which needs no key and costs nothing.
GOOGLE_PLACES_API_KEY=

# Optional overrides (useful for a self-hosted Overpass mirror or a proxy)
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Overpass/Nominatim ask clients to identify themselves.
SOURCING_USER_AGENT=AI-Invincible-Office/2.0 (lead research; contact via app)

# --- Advanced ------------------------------------------------
# Model request timeout in milliseconds
AI_TIMEOUT_MS=60000
