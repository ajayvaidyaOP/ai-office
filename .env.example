# ============================================================
# AI Invincible Office — environment configuration
# Copy this file to .env and fill in what you have.
# Never commit .env. Never paste these values into Google Sheets.
# ============================================================

# --- App -----------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Folder for the office database (git-ignored by default)
DATA_DIR=./data
# Seed the Chapter 4 / Chapter 7 worked example on first boot
SEED_DEMO=true
# Used for dates in reports: Asia/Kolkata, UTC, etc.
OFFICE_TIMEZONE=Asia/Kolkata

# --- Access control (Chapter 9) ------------------------------
# Only these IDs may run commands. Comma separated. "owner" is the web console.
ALLOWED_USER_IDS=owner

# --- AI provider ---------------------------------------------
# auto | ollama | gemini | offline
AI_PROVIDER=auto

# Ollama (local, free). When n8n runs in Docker use host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Gemini (optional hosted fallback). Keep the key out of Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Hard stop for model calls per day (protects your wallet)
MAX_MODEL_CALLS_PER_DAY=200

# --- Google Sheets (optional sync, Chapters 4 + 8) -----------
# Create a sheet named "AI Invincible Office" with tabs: Tasks, Drafts, Leads, Daily Log
GOOGLE_SHEETS_ID=
# Path to a service-account JSON if you want the server to sync rows directly
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Telegram (Chapter 3) ------------------------------------
# Token from @BotFather. Keep it in .env or the n8n credential store only.
TELEGRAM_BOT_TOKEN=
# Comma separated numeric Telegram user IDs allowed to trigger workflows
ALLOWED_TELEGRAM_USER_IDS=
# off = no connector | polling = long-poll (local, no public URL)
TELEGRAM_MODE=off

# Shared secret for POST /api/webhook/telegram (optional bridge mode)
WEBHOOK_SECRET=

# --- Access gate (optional) ----------------------------------
# If set, every /api/* call needs the header: x-office-code: <value>
# Use this if the console is reachable from a network you do not fully trust.
OFFICE_ACCESS_CODE=

# --- Advanced ------------------------------------------------
# Model request timeout in milliseconds
AI_TIMEOUT_MS=60000
